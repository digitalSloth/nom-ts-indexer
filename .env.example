# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL. These match the Postgres service in docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=zenon
DATABASE_PASSWORD=zenon_password
DATABASE_NAME=nom_indexer

# TLS for managed Postgres. Verifies the server certificate.
# DATABASE_SSL=true
# Optional CA certificate file, for providers with a private CA
# DATABASE_SSL_CA=/path/to/ca.pem

# ============================================================================
# REDIS CONFIGURATION (for distributed locking)
# ============================================================================

# docker-compose.yml publishes Redis on host port 6378
REDIS_HOST=localhost
REDIS_PORT=6378

# Optional: Redis password if authentication is enabled
# REDIS_PASSWORD=your_redis_password

# Optional: Redis database number (default: 0)
# REDIS_DB=0

# Optional: prefix on every Redis key (default: indexer:). Give each network
# its own prefix when several indexers share one Redis database, for example
# indexer:mainnet:
# REDIS_KEY_PREFIX=indexer:

# ============================================================================
# ZENON NETWORK CONFIGURATION
# ============================================================================

# Defaults target a local devnet node. Inside the Docker indexer container,
# use host.docker.internal instead of localhost to reach a node on the host.

# Chain ID (1 = mainnet, 3 = testnet, 69 = local devnet)
CHAIN_ID=69

# WebSocket endpoints, used for all RPC calls and momentum subscriptions.
# List backups after the primary, comma-separated, for failover:
# ZNN_WS_URL=wss://primary:35998,wss://backup:35998
ZNN_WS_URL=ws://localhost:35998

# Genesis file for the seeders and plugins. It must match CHAIN_ID.
GENESIS_PATH=json/genesis-devnet.json

# Mainnet:
# CHAIN_ID=1
# ZNN_WS_URL=wss://my.hc1node.com:35998
# GENESIS_PATH=json/genesis-mainnet.json

# ============================================================================
# INDEXER CONFIGURATION
# ============================================================================

# Number of momentums to fetch per batch (default: 100)
# Higher values = faster indexing but more memory usage
BATCH_SIZE=100

# Enable debug logging
DEBUG=false

# Fail over to the healthiest node when no momentum is indexed for this many
# seconds (default: 300)
# STALL_EXIT_SECONDS=300

# ============================================================================
# WEBHOOKS (optional)
# ============================================================================

# Single-endpoint setup (alternative to webhooks.json)
# WEBHOOK_URL=https://example.com/hooks/indexer

# Optional HMAC secret. When set, requests include an `X-Webhook-Signature`
# header containing `sha256=<hex hmac of body>`.
# WEBHOOK_SECRET=replace-me

# Optional comma-separated filter. Defaults to all known events.
# Known: momentum.inserted, account_block.inserted
# WEBHOOK_EVENTS=momentum.inserted,account_block.inserted

# Optional override for the webhooks JSON config file path (default: webhooks.json)
# WEBHOOKS_CONFIG_PATH=./webhooks.json

# ============================================================================
# API SERVER
# ============================================================================

# Port for the HTTP API server (default: 3500)
API_PORT=3500

# ============================================================================
# PLUGINS
# ============================================================================

# Path to plugins configuration file (default: plugins.json)
# PLUGINS_CONFIG_PATH=plugins.json

# Custom start height — skip indexing below this momentum height (only on fresh start).
# If the indexer has already synced past this height, it continues from where it left off.
# START_HEIGHT=1000000

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================

NODE_ENV=development
