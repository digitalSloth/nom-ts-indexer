# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL (recommended)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_NAME=nom_indexer

# Or use a connection string:
# DATABASE_URL="postgresql://username:password@localhost:5432/nom_indexer"

# ============================================================================
# REDIS CONFIGURATION (for distributed locking)
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379

# Optional: Redis password if authentication is enabled
# REDIS_PASSWORD=your_redis_password

# Optional: Redis database number (default: 0)
# REDIS_DB=0

# ============================================================================
# ZENON NETWORK CONFIGURATION
# ============================================================================

# Chain ID (1 = mainnet, 3 = testnet)
CHAIN_ID=1

# HTTP RPC endpoint for historical data fetching
ZNN_RPC_URL=http://localhost:35997

# WebSocket endpoint for real-time momentum subscriptions
ZNN_WS_URL=ws://localhost:35998

# Public nodes (examples):
# Mainnet RPC: https://my.hc1node.com:35997
# Mainnet WS: wss://my.hc1node.com:35998
# Testnet RPC: http://testnet.znn.space:35997
# Testnet WS: ws://testnet.znn.space:35998

# ============================================================================
# INDEXER CONFIGURATION
# ============================================================================

# Number of momentums to fetch per batch (default: 100)
# Higher values = faster indexing but more memory usage
BATCH_SIZE=100

# Enable debug logging
DEBUG=false

# ============================================================================
# WEBHOOKS (optional)
# ============================================================================

# Single-endpoint setup (alternative to webhooks.json)
# WEBHOOK_URL=https://example.com/hooks/indexer

# Optional HMAC secret. When set, requests include an `X-Webhook-Signature`
# header containing `sha256=<hex hmac of body>`.
# WEBHOOK_SECRET=replace-me

# Optional comma-separated filter. Defaults to all known events.
# Known: momentum.inserted, account_block.inserted
# WEBHOOK_EVENTS=momentum.inserted,account_block.inserted

# Optional override for the webhooks JSON config file path (default: webhooks.json)
# WEBHOOKS_CONFIG_PATH=./webhooks.json

# Path to the network genesis JSON file used by the seeders and plugin runtime
# (default: json/genesis.json)
# GENESIS_PATH=json/genesis.json

# ============================================================================
# API SERVER
# ============================================================================

# Port for the HTTP API server (default: 3500)
API_PORT=3500

# ============================================================================
# PLUGINS
# ============================================================================

# Path to plugins configuration file (default: plugins.json)
# PLUGINS_CONFIG_PATH=plugins.json

# Custom start height — skip indexing below this momentum height (only on fresh start).
# If the indexer has already synced past this height, it continues from where it left off.
# START_HEIGHT=1000000

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================

NODE_ENV=development
