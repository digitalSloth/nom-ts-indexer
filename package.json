{
  "name": "nom-ts-indexer",
  "version": "1.0.0",
  "description": "TypeScript blockchain indexer for Zenon Network",
  "type": "module",
  "main": "dist/index.js",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsx src/database/scripts/sync-plugin-migrations.ts && tsc && for dir in plugins/*/; do (cd \"$dir\" && npx tsc); done",
    "start": "node dist/index.js",
    "reset": "npm run db:fresh && npm run db:migrate && npm run db:seed",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "db:migrate": "tsx node_modules/.bin/knex migrate:latest --knexfile src/database/knexfile.ts",
    "db:migrate:make": "tsx node_modules/.bin/knex migrate:make --knexfile src/database/knexfile.ts --name",
    "db:fresh": "tsx src/database/scripts/db-fresh.ts",
    "db:seed": "node dist/database/seeders/index.js",
    "db:sync-plugins": "tsx src/database/scripts/sync-plugin-migrations.ts",
    "lock:clear": "tsx src/scripts/clear-locks.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "blockchain",
    "indexer",
    "typescript",
    "zenon"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "ioredis": "^5.3.2",
    "knex": "^3.2.10",
    "pg": "^8.20.0",
    "znn-typescript-sdk": "github:digitalSloth/znn-typescript-sdk#feature/abi-helpers"
  }
}
