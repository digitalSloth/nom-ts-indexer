# Docker Environment Variables
# Copy this to .env when using Docker Compose

# Zenon Network Configuration
ZNN_RPC_URL=https://my.hc1node.com:35997
ZNN_WS_URL=wss://my.hc1node.com:35998

# For testnet:
# ZNN_RPC_URL=http://testnet.znn.space:35997
# ZNN_WS_URL=ws://testnet.znn.space:35998

# Indexer Configuration
BATCH_SIZE=100
DEBUG=false
NODE_ENV=production
